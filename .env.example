# Banco de dados (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Auth
NEXTAUTH_SECRET=your-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Meta WhatsApp
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=random-string-for-webhook-verification
NEXT_PUBLIC_META_APP_ID=    # mesmo que META_APP_ID
NEXT_PUBLIC_META_CONFIG_ID= # ID da configuração Embedded Signup v4

# Criptografia (gerar: openssl rand -hex 32)
ENCRYPTION_KEY=

# Billing Brasil - Mercado Pago
MP_ACCESS_TOKEN=
MP_PLAN_ID=
MP_WEBHOOK_SECRET=

# Billing Global - Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=

# IA (Anthropic)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_URL=http://localhost:3000
