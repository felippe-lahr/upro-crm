generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Public schema models ────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  email       String   @unique
  plan        String   @default("trial")
  status      String   @default("pending_payment")
  schema_name String   @unique

  waba_id             String?
  phone_number_id     String?
  whatsapp_token      String?
  whatsapp_connected  Boolean  @default(false)

  bot_enabled         Boolean  @default(false)
  bot_prompt          String?

  mp_subscription_id  String?
  stripe_customer_id  String?
  trial_ends_at       DateTime?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users       TenantUser[]

  @@map("tenants")
}

model TenantUser {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  email         String
  name          String?
  role          String   @default("agent")
  password_hash String
  created_at    DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, email])
  @@map("tenant_users")
}

model SaasConfig {
  id              String   @id @default("singleton")
  price_basic     Decimal  @default(97)  @db.Decimal(10, 2)
  price_pro       Decimal  @default(197) @db.Decimal(10, 2)
  annual_discount Int      @default(20)
  updated_at      DateTime @updatedAt

  @@map("saas_config")
}

model Coupon {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique
  description     String?
  discount_type   String    @default("percent")  // "percent" | "fixed"
  discount_value  Decimal   @db.Decimal(10, 2)
  max_uses        Int?
  uses_count      Int       @default(0)
  expires_at      DateTime?
  active          Boolean   @default(true)
  created_at      DateTime  @default(now())

  @@map("coupons")
}

// ─── Tenant-scoped models (used with dynamic schema) ─────────────────────────

model Contact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  whatsapp_id  String   @unique
  name         String?
  phone        String
  stage        String   @default("novo_lead")
  deal_value   Decimal? @db.Decimal(12, 2)
  notes        String?
  tags         String[] @default([])
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  messages     Message[]
  conversations Conversation[]

  @@map("contacts")
}

model QuickReply {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shortcut   String   @unique
  content    String
  created_at DateTime @default(now())

  @@map("quick_replies")
}

model Broadcast {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message     String
  status      String   @default("draft")
  total       Int      @default(0)
  sent_count  Int      @default(0)
  failed_count Int     @default(0)
  filter_tag  String?
  created_at  DateTime @default(now())
  sent_at     DateTime?

  @@map("broadcasts")
}

model Conversation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id String   @db.Uuid
  status     String   @default("open")
  assigned_to String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contact    Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  messages   Message[]

  @@map("conversations")
}

model Message {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  whatsapp_id     String?  @unique
  contact_id      String   @db.Uuid
  conversation_id String?  @db.Uuid
  direction       String
  type            String   @default("text")
  content         String?
  media_url       String?
  sent_by_bot     Boolean  @default(false)
  timestamp       DateTime @default(now())

  contact         Contact       @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversation_id], references: [id])

  @@map("messages")
}

model Agent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  name       String
  role       String   @default("agent")
  created_at DateTime @default(now())

  @@map("agents")
}
