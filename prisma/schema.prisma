generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Public schema models ────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  email       String   @unique
  plan        String   @default("trial")
  status      String   @default("pending_payment")
  schema_name String   @unique

  waba_id             String?
  phone_number_id     String?
  whatsapp_token      String?
  whatsapp_connected  Boolean  @default(false)
  display_phone_number String? // número legível conectado (ex.: +55 11 9...) — via Graph
  verified_name        String? // nome verificado do WhatsApp Business — via Graph

  bot_enabled         Boolean  @default(false)
  bot_prompt          String?
  summary_instructions String? // Pro: orienta o que o resumo (ai_summary) deve conter e o formato
  lead_tags           String[] @default([]) // Pro: taxonomia de etiquetas que a IA pode aplicar aos leads
  auto_tag_enabled    Boolean  @default(true) // Pro: quando off, a IA não etiqueta sozinha (só manual)
  ads_wa_number       String?  // número do WhatsApp (E.164, só dígitos) usado nos links de anúncio /r/wa
  broadcast_consent_template String? // nome do template de consentimento aprovado na WABA

  menu_bot_enabled    Boolean  @default(false)
  menu_bot_greeting   String?
  menu_bot_options    Json?

  handoff_pause              Boolean  @default(false)
  keep_responding_after_human Boolean @default(false)

  // 4.1 — encaminhar resumo do atendimento para WhatsApp do gestor (feature de nicho)
  feature_summary_forward  Boolean @default(false) // entitlement ligado SÓ pelo superadmin

  // Resumo de pedido: o bot monta um pedido a partir do catálogo no prompt e gera
  // um PDF (não conclui a venda — vai para um vendedor). Entitlement do superadmin.
  feature_orders           Boolean @default(false)
  summary_forward_number   String? // destino E.164 (só dígitos)
  summary_forward_template String? // nome do template aprovado na WABA
  last_send_status         Json?   // diagnóstico: último status de entrega recebido da Meta (delivered/failed + erro)

  funnel_labels       Json?    // { stageId: label } — nomes personalizados das etapas (Pro)
  loss_reasons        Json?    // string[] — até 10 motivos de perda (Pro)

  scheduling_enabled     Boolean @default(true)  // Agenda: quando off, o bot nunca oferece nem marca horários
  booking_gap_min        Int   @default(0)
  booking_min_notice_min Int   @default(0)

  // Promaster — catálogo de produtos por feed XML (Google Merchant/RSS 2.0)
  products_feed_url   String?
  products_synced_at  DateTime?
  products_count      Int      @default(0)

  mp_subscription_id  String?
  mp_access_token     String?  // token MP do lojista (recebe os sinais de agendamento) — criptografado
  stripe_customer_id  String?
  trial_ends_at       DateTime?

  referred_by         String?  @db.Uuid

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users       TenantUser[]
  affiliate   Affiliate? @relation(fields: [referred_by], references: [id])

  @@map("tenants")
}

model Affiliate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String   @unique
  password_hash    String
  code             String   @unique
  commission_type  String   @default("percent")    // "percent" | "fixed"
  commission_value Decimal  @default(30) @db.Decimal(10, 2)
  recurrence       String   @default("lifetime")    // "lifetime" | "first" | "12m"
  status           String   @default("pending")     // "pending" | "active" | "rejected" | "suspended"
  pix_key          String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenants     Tenant[]
  commissions AffiliateCommission[]

  @@map("affiliates")
}

model AffiliateCommission {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id    String   @db.Uuid
  tenant_id       String   @db.Uuid
  amount          Decimal  @db.Decimal(10, 2)
  base_amount     Decimal  @db.Decimal(10, 2)
  reference_month String                            // "2026-06"
  status          String   @default("pending")      // "pending" | "paid"
  created_at      DateTime @default(now())

  affiliate   Affiliate @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)

  @@unique([affiliate_id, tenant_id, reference_month])
  @@map("affiliate_commissions")
}

// Mapeamento global de pagamentos Pix de agendamento -> tenant/agendamento.
// Permite ao webhook do Mercado Pago rotear a confirmação para o schema correto.
model AppointmentPayment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id     String   @unique // id do pagamento no Mercado Pago
  tenant_id      String   @db.Uuid
  schema_name    String
  appointment_id String   @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  status         String   @default("pending") // pending | approved | expired
  created_at     DateTime @default(now())

  @@map("appointment_payments")
}

// Clique de anúncio (Google Ads) capturado no redirecionamento /r/wa.
// Guarda o gclid/UTMs por um código curto que viaja no texto pré-preenchido do
// WhatsApp; o webhook casa o código com a 1ª mensagem e atribui a origem ao lead.
model AdClick {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String    @unique
  tenant_id    String    @db.Uuid
  gclid        String?
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_term     String?
  utm_content  String?
  matched_at   DateTime?
  created_at   DateTime  @default(now())

  @@index([tenant_id])
  @@map("ad_clicks")
}

// Índice global de pedidos (resumo de pedido). Permite servir o PDF público por
// um token opaco sem expor o schema do tenant na URL. O pedido em si fica no
// schema do tenant (model Order); aqui guardamos só o roteamento.
model OrderRef {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String   @unique
  tenant_id   String   @db.Uuid
  schema_name String
  order_id    String   @db.Uuid
  created_at  DateTime @default(now())

  @@map("order_refs")
}

// Token de recuperação de senha (esqueci a senha). Guarda só o HASH do token.
model PasswordReset {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  token_hash String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("password_resets")
}

// Inscrição de notificação push (Web Push) de um usuário/dispositivo.
model PushSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  user_email String
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now())

  @@index([tenant_id])
  @@map("push_subscriptions")
}

model TenantUser {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  email         String
  name          String?
  role          String   @default("agent")
  password_hash String
  created_at    DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, email])
  @@map("tenant_users")
}

model SaasConfig {
  id              String   @id @default("singleton")
  price_basic     Decimal  @default(97)  @db.Decimal(10, 2)
  price_pro       Decimal  @default(197) @db.Decimal(10, 2)
  price_promaster Decimal  @default(297) @db.Decimal(10, 2)
  annual_discount Int      @default(20)
  updated_at      DateTime @updatedAt

  @@map("saas_config")
}

model Coupon {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique
  description     String?
  discount_type   String    @default("percent")  // "percent" | "fixed"
  discount_value  Decimal   @db.Decimal(10, 2)
  max_uses        Int?
  uses_count      Int       @default(0)
  expires_at      DateTime?
  active          Boolean   @default(true)
  created_at      DateTime  @default(now())

  @@map("coupons")
}

// ─── Tenant-scoped models (used with dynamic schema) ─────────────────────────

model Contact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  whatsapp_id  String   @unique // id endereçável do webhook (telefone/wa_id ou BSUID) — usado para responder
  bsuid        String?  // Business-Scoped User ID (identificador estável por empresa)
  name         String?
  phone        String
  email        String?
  stage        String   @default("novo_lead")
  deal_value   Decimal? @db.Decimal(12, 2)
  notes        String?
  ai_summary   String?
  loss_reason  String?  // motivo da perda (quando stage = perdido)
  tags         String[] @default([])
  opted_out    Boolean  @default(false) // respondeu SAIR — nunca mais entra em disparos
  lead_source  Json?    // origem do lead: {kind, platform, headline, source_id, source_url, ctwa_clid} — anúncios CTWA
  last_read_at DateTime? // última vez que um atendente abriu esta conversa (para o badge de não vistas)
  summary_forwarded_at DateTime? // 4.1 — quando o resumo já foi encaminhado (trava anti-duplicação)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  messages     Message[]
  conversations Conversation[]
  appointments Appointment[]
  orders       Order[]

  @@index([bsuid])
  @@map("contacts")
}

// Pedido montado pelo bot (resumo de pedido). NÃO é uma venda concluída: é um
// resumo para um vendedor humano processar. Os itens ficam em JSON (nome,
// quantidade, preço unitário e subtotal); um PDF é gerado sob demanda.
model Order {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id     String?  @db.Uuid
  customer_name  String?
  customer_phone String?
  items          Json     // [{ nome, quantidade, preco_unit, subtotal }]
  total          Decimal  @db.Decimal(12, 2)
  notes          String?  // observações do cliente
  status         String   @default("novo") // novo | em_separacao | concluido | cancelado
  public_token   String   @unique // token do OrderRef (para o link do PDF)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  contact Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("orders")
}

model QuickReply {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shortcut   String   @unique
  content    String
  created_at DateTime @default(now())

  @@map("quick_replies")
}

model Broadcast {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message     String
  status      String   @default("draft")
  total       Int      @default(0)
  sent_count  Int      @default(0)
  failed_count Int     @default(0)
  filter_tag  String?
  created_at  DateTime @default(now())
  sent_at     DateTime?

  @@map("broadcasts")
}

model Conversation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id String   @db.Uuid
  status     String   @default("open")
  assigned_to String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contact    Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  messages   Message[]

  @@map("conversations")
}

model Message {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  whatsapp_id     String?  @unique
  contact_id      String   @db.Uuid
  conversation_id String?  @db.Uuid
  direction       String
  type            String   @default("text")
  content         String?
  media_url       String?
  sent_by_bot     Boolean  @default(false)
  timestamp       DateTime @default(now())

  contact         Contact       @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversation_id], references: [id])

  @@map("messages")
}

model Agent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  name       String
  role       String   @default("agent")
  created_at DateTime @default(now())

  @@map("agents")
}

// ─── Agendamento (tenant-scoped) ─────────────────────────────────────────────

model Service {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  duration_min   Int      @default(60)
  price          Decimal? @db.Decimal(10, 2)
  active         Boolean  @default(true)
  gap_min        Int      @default(0) // intervalo entre atendimentos deste serviço
  min_notice_min Int      @default(0) // antecedência mínima para agendar este serviço
  charge_mode    String   @default("none") // none | fixed | percent | full
  charge_value   Decimal? @db.Decimal(10, 2) // valor do sinal (fixed) ou porcentagem (percent)
  hold_minutes   Int      @default(30) // prazo para pagar o sinal antes de liberar o horário
  created_at     DateTime @default(now())

  appointments Appointment[]
  availability Availability[]

  @@map("services")
}

model Availability {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id String? @db.Uuid // horário específico de um serviço (null = padrão do tenant)
  weekday    Int     // 0=Domingo … 6=Sábado
  start_min  Int     // minutos desde 00:00 (ex: 480 = 08:00)
  end_min    Int

  service Service? @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id, weekday])
  @@map("availability")
}

model Appointment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id     String?  @db.Uuid
  service_id     String?  @db.Uuid
  customer_name  String?  // para quem é o atendimento (participante: aluno/paciente/próprio)
  customer_phone String?
  customer_email String?
  booked_by      String?  // quem agendou (responsável), quando diferente do participante
  title          String?
  start_at       DateTime
  end_at         DateTime
  status         String   @default("scheduled") // scheduled|confirmed|cancelled|done|no_show|pending_payment
  notes          String?
  amount_due     Decimal? @db.Decimal(10, 2) // valor a pagar (sinal) quando exige pagamento
  payment_id     String?  // id do pagamento Pix no Mercado Pago
  payment_status String?  // pending | approved | expired
  hold_expires_at DateTime? // prazo da pré-reserva aguardando pagamento
  reminder_sent     Boolean  @default(false) // lembrete de 1 dia antes
  day_reminder_sent Boolean  @default(false) // lembrete no dia do agendamento
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  contact Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [service_id], references: [id], onDelete: SetNull)

  @@index([start_at])
  @@map("appointments")
}

// ─── Catálogo Promaster (tenant-scoped) ──────────────────────────────────────
// Produtos importados do feed XML (Google Merchant/RSS 2.0). Sincronizados por
// cron; o bot vendedor consulta esta tabela e envia o link da página do produto.
model Product {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feed_id      String   @unique // <g:id> do feed — chave do upsert
  title        String
  description  String?
  brand        String?
  category     String?  // <g:product_type> (breadcrumb)
  price        Decimal? @db.Decimal(12, 2)
  sale_price   Decimal? @db.Decimal(12, 2)
  in_stock     Boolean  @default(true)
  url          String?  // <link> — página do produto (o bot envia isto)
  image        String?
  gtin         String?
  sku          String?  // <g:mpn>
  installments Json?    // { months, amount } de <g:installment>
  synced_at    DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([brand])
  @@index([in_stock])
  @@map("products")
}
