generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Public schema models ────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  email       String   @unique
  plan        String   @default("trial")
  status      String   @default("pending_payment")
  schema_name String   @unique

  waba_id             String?
  phone_number_id     String?
  whatsapp_token      String?
  whatsapp_connected  Boolean  @default(false)

  bot_enabled         Boolean  @default(false)
  bot_prompt          String?

  menu_bot_enabled    Boolean  @default(false)
  menu_bot_greeting   String?
  menu_bot_options    Json?

  handoff_pause              Boolean  @default(false)
  keep_responding_after_human Boolean @default(false)

  booking_gap_min        Int   @default(0)
  booking_min_notice_min Int   @default(0)

  mp_subscription_id  String?
  stripe_customer_id  String?
  trial_ends_at       DateTime?

  referred_by         String?  @db.Uuid

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users       TenantUser[]
  affiliate   Affiliate? @relation(fields: [referred_by], references: [id])

  @@map("tenants")
}

model Affiliate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String   @unique
  password_hash    String
  code             String   @unique
  commission_type  String   @default("percent")    // "percent" | "fixed"
  commission_value Decimal  @default(30) @db.Decimal(10, 2)
  recurrence       String   @default("lifetime")    // "lifetime" | "first" | "12m"
  status           String   @default("pending")     // "pending" | "active" | "rejected" | "suspended"
  pix_key          String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenants     Tenant[]
  commissions AffiliateCommission[]

  @@map("affiliates")
}

model AffiliateCommission {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id    String   @db.Uuid
  tenant_id       String   @db.Uuid
  amount          Decimal  @db.Decimal(10, 2)
  base_amount     Decimal  @db.Decimal(10, 2)
  reference_month String                            // "2026-06"
  status          String   @default("pending")      // "pending" | "paid"
  created_at      DateTime @default(now())

  affiliate   Affiliate @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)

  @@unique([affiliate_id, tenant_id, reference_month])
  @@map("affiliate_commissions")
}

model TenantUser {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  email         String
  name          String?
  role          String   @default("agent")
  password_hash String
  created_at    DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, email])
  @@map("tenant_users")
}

model SaasConfig {
  id              String   @id @default("singleton")
  price_basic     Decimal  @default(97)  @db.Decimal(10, 2)
  price_pro       Decimal  @default(197) @db.Decimal(10, 2)
  annual_discount Int      @default(20)
  updated_at      DateTime @updatedAt

  @@map("saas_config")
}

model Coupon {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique
  description     String?
  discount_type   String    @default("percent")  // "percent" | "fixed"
  discount_value  Decimal   @db.Decimal(10, 2)
  max_uses        Int?
  uses_count      Int       @default(0)
  expires_at      DateTime?
  active          Boolean   @default(true)
  created_at      DateTime  @default(now())

  @@map("coupons")
}

// ─── Tenant-scoped models (used with dynamic schema) ─────────────────────────

model Contact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  whatsapp_id  String   @unique
  name         String?
  phone        String
  email        String?
  stage        String   @default("novo_lead")
  deal_value   Decimal? @db.Decimal(12, 2)
  notes        String?
  ai_summary   String?
  tags         String[] @default([])
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  messages     Message[]
  conversations Conversation[]
  appointments Appointment[]

  @@map("contacts")
}

model QuickReply {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shortcut   String   @unique
  content    String
  created_at DateTime @default(now())

  @@map("quick_replies")
}

model Broadcast {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message     String
  status      String   @default("draft")
  total       Int      @default(0)
  sent_count  Int      @default(0)
  failed_count Int     @default(0)
  filter_tag  String?
  created_at  DateTime @default(now())
  sent_at     DateTime?

  @@map("broadcasts")
}

model Conversation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id String   @db.Uuid
  status     String   @default("open")
  assigned_to String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contact    Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  messages   Message[]

  @@map("conversations")
}

model Message {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  whatsapp_id     String?  @unique
  contact_id      String   @db.Uuid
  conversation_id String?  @db.Uuid
  direction       String
  type            String   @default("text")
  content         String?
  media_url       String?
  sent_by_bot     Boolean  @default(false)
  timestamp       DateTime @default(now())

  contact         Contact       @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversation_id], references: [id])

  @@map("messages")
}

model Agent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  name       String
  role       String   @default("agent")
  created_at DateTime @default(now())

  @@map("agents")
}

// ─── Agendamento (tenant-scoped) ─────────────────────────────────────────────

model Service {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  duration_min Int      @default(60)
  price        Decimal? @db.Decimal(10, 2)
  active       Boolean  @default(true)
  created_at   DateTime @default(now())

  appointments Appointment[]

  @@map("services")
}

model Availability {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekday   Int    // 0=Domingo … 6=Sábado
  start_min Int    // minutos desde 00:00 (ex: 480 = 08:00)
  end_min   Int

  @@map("availability")
}

model Appointment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id     String?  @db.Uuid
  service_id     String?  @db.Uuid
  customer_name  String?
  customer_phone String?
  title          String?
  start_at       DateTime
  end_at         DateTime
  status         String   @default("scheduled") // scheduled|confirmed|cancelled|done|no_show
  notes          String?
  reminder_sent     Boolean  @default(false) // lembrete de 1 dia antes
  day_reminder_sent Boolean  @default(false) // lembrete no dia do agendamento
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  contact Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [service_id], references: [id], onDelete: SetNull)

  @@index([start_at])
  @@map("appointments")
}
